{
  "name": "dsh-power-after-task",
  "version": "1.0.1",
  "description": "DeepSeek Harness (DSH) plugin for Windows: sleep, shut down, or restart the PC once the current agent task finishes. Ships disabled; arm it from a compact composer-dock control, watch a frame-wide countdown ribbon you can cancel any time. No dependencies, no build step.",
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "cordis-plugin",
    "plugin",
    "bundle",
    "web-plugin",
    "windows",
    "power",
    "power-management",
    "shutdown",
    "restart",
    "sleep",
    "hibernate",
    "suspend",
    "agent-task",
    "countdown"
  ],
  "license": "MIT",
  "author": "Mori",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/white-sparrow/dsh-power-after-task.git"
  },
  "homepage": "https://github.com/white-sparrow/dsh-power-after-task#readme",
  "bugs": {
    "url": "https://github.com/white-sparrow/dsh-power-after-task/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "prepublishOnly": "npm run check",
    "prepack": "npm run check",
    "stage": "node scripts/npm-auth.mjs stage publish",
    "stage:list": "node scripts/npm-auth.mjs stage list",
    "stage:view": "node scripts/npm-auth.mjs stage view",
    "stage:approve": "node scripts/npm-auth.mjs stage approve",
    "stage:reject": "node scripts/npm-auth.mjs stage reject",
    "stage:download": "node scripts/npm-auth.mjs stage download",
    "publish:local": "node scripts/npm-auth.mjs publish"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
